{
  "name": "kanchaya",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": "24.5.0",
    "pnpm": "11.5.2"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --recursive build",
    "test": "pnpm --recursive test",
    "lint": "pnpm --recursive lint",
    "format": "pnpm --recursive format",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:ps": "docker compose ps",
    "db:contract:emit": "pnpm --filter api run db:contract:emit",
    "db:generate": "pnpm run db:contract:emit",
    "db:plan": "pnpm --filter api run db:plan",
    "db:migrate": "pnpm --filter api run db:migrate",
    "db:verify": "pnpm --filter api run db:verify"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "supabase": "^2.117.0"
  }
}
